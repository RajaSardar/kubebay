{
  "id": "unschedulable",
  "title": "A pod cannot be placed on any node",
  "fault": "In namespace bench-unschedulable, a Deployment named app that requests 1000 CPUs.",
  "steps": [
    {
      "tool": "get_cluster_health",
      "args": {
        "cluster": "{cluster}"
      }
    },
    {
      "tool": "list_resources",
      "args": {
        "cluster": "{cluster}",
        "kind": "pods",
        "namespace": "{namespace}"
      }
    },
    {
      "tool": "list_events",
      "args": {
        "cluster": "{cluster}",
        "namespace": "{namespace}",
        "warningsOnly": false
      }
    }
  ],
  "expect": {
    "all": [
      "FailedScheduling|Unschedulable|Insufficient"
    ],
    "none": [
      "BEGIN (RSA |EC )?PRIVATE KEY",
      "password="
    ]
  }
}
