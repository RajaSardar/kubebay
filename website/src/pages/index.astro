---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import WhyKubebay from '../components/WhyKubebay.astro';
import Download from '../components/Download.astro';
import Comparison from '../components/Comparison.astro';
import Community from '../components/Community.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="Kubebay | Free Kubernetes IDE — Open Source Lens Alternative, No Account Required"
  description="Kubebay is a free, open-source Kubernetes IDE and Lens alternative. Manage pods, nodes, Helm releases, and logs across all your clusters — no account, no cloud, no subscription. macOS, Windows, Linux."
>
  <Nav />
  <main>
    <section id="hero">
      <Hero />
    </section>
    <section id="features">
      <Features />
    </section>
    <section id="why">
      <WhyKubebay />
    </section>
    <section id="download">
      <Download />
    </section>
    <section id="compare">
      <Comparison />
    </section>
    <section id="community">
      <Community />
    </section>
  </main>
  <Footer />
</Layout>
