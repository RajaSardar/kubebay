---
const navLinks = [
  { label: 'Features',  href: '#features' },
  { label: 'Download',  href: '#download' },
  { label: 'Docs',      href: 'https://github.com/RajaSardar/kubebay/tree/main/docs' },
  { label: 'Changelog', href: 'https://github.com/RajaSardar/kubebay/blob/main/CHANGELOG.md' },
];

const repoURL = 'https://github.com/RajaSardar/kubebay';
---

<header id="site-nav">
  <nav class="nav-inner">
    <!-- Logo -->
    <a href="/" class="logo" aria-label="Kubebay home">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="logo-grad" x1="0" y1="0" x2="28" y2="28" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#22d3ee"/>
            <stop offset="100%" stop-color="#41c98e"/>
          </linearGradient>
        </defs>
        <!-- Outer rounded square -->
        <rect width="28" height="28" rx="7" fill="url(#logo-grad)" opacity="0.15"/>
        <!-- Bold K letterform -->
        <text
          x="5" y="21"
          font-family="Inter, sans-serif"
          font-weight="700"
          font-size="18"
          fill="url(#logo-grad)"
        >K</text>
        <!-- Subtle anchor-dot at bottom right -->
        <circle cx="22" cy="22" r="2.5" fill="#22d3ee" opacity="0.7"/>
      </svg>
      <span class="wordmark">Kubebay</span>
    </a>

    <!-- Center links (desktop) -->
    <ul class="nav-links" id="nav-links" role="list">
      {navLinks.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="nav-link"
            target={href.startsWith('http') ? '_blank' : undefined}
            rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Right actions -->
    <div class="nav-actions">
      <!-- GitHub star button -->
      <a
        href={repoURL}
        class="github-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Star Kubebay on GitHub"
      >
        <!-- Star icon -->
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span>Star</span>
        <!-- GitHub mark -->
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="gh-icon">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.1 3.29 9.42 7.86 10.95.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.19a11.1 11.1 0 0 1 2.9-.39c.98 0 1.97.13 2.9.39 2.2-1.5 3.17-1.19 3.17-1.19.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.43-2.7 5.41-5.27 5.69.42.36.79 1.06.79 2.14v3.17c0 .31.2.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
        </svg>
      </a>

      <!-- Download CTA -->
      <a href="#download" class="cta-btn">
        Download
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
      </a>

      <!-- Hamburger (mobile) -->
      <button
        class="hamburger"
        id="hamburger"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="nav-links"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<script>
  // Scroll: add .scrolled class for backdrop/border effect
  const header = document.getElementById('site-nav');
  const onScroll = () => {
    if (header) {
      header.classList.toggle('scrolled', window.scrollY > 12);
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll(); // initial check

  // Hamburger: toggle nav-links visibility
  const hamburger = document.getElementById('hamburger');
  const navLinks  = document.getElementById('nav-links');

  hamburger?.addEventListener('click', () => {
    const expanded = hamburger.getAttribute('aria-expanded') === 'true';
    hamburger.setAttribute('aria-expanded', String(!expanded));
    hamburger.classList.toggle('open', !expanded);
    navLinks?.classList.toggle('mobile-open', !expanded);
  });

  // Close mobile menu on link click
  navLinks?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      hamburger?.setAttribute('aria-expanded', 'false');
      hamburger?.classList.remove('open');
      navLinks.classList.remove('mobile-open');
    });
  });
</script>

<style>
  /* ─── Header shell ─────────────────────────────────────── */
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    /* transparent by default; transitions on scroll */
    background: transparent;
    transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    border-bottom: 1px solid transparent;
  }

  header.scrolled {
    background: rgba(9, 9, 9, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: rgba(255, 255, 255, 0.06);
    box-shadow: 0 1px 24px rgba(0, 0, 0, 0.4);
  }

  /* ─── Inner container ──────────────────────────────────── */
  .nav-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 0;
  }

  /* ─── Logo ──────────────────────────────────────────────── */
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .wordmark {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #22d3ee, #41c98e);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }

  /* ─── Center nav links ──────────────────────────────────── */
  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    justify-content: center;
  }

  .nav-link {
    display: block;
    padding: 6px 14px;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    border-radius: 8px;
    transition: color 0.15s ease, background 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  /* ─── Right actions ─────────────────────────────────────── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  /* GitHub star button */
  .github-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }

  .github-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .github-btn .gh-icon {
    opacity: 0.6;
  }

  .github-btn:hover .gh-icon {
    opacity: 1;
  }

  /* Download CTA */
  .cta-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: #090909;
    text-decoration: none;
    background: linear-gradient(135deg, #22d3ee, #41c98e);
    border-radius: 8px;
    transition: opacity 0.15s, transform 0.15s;
  }

  .cta-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .cta-btn:active {
    transform: translateY(0);
  }

  /* ─── Hamburger ─────────────────────────────────────────── */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 6px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s;
  }

  .hamburger:hover {
    background: rgba(255, 255, 255, 0.07);
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 2px;
    transition: transform 0.22s ease, opacity 0.22s ease;
    transform-origin: center;
  }

  /* Open (X) state */
  .hamburger.open span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .hamburger.open span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger.open span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ─── Mobile ────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .hamburger {
      display: flex;
    }

    .github-btn span {
      display: none; /* hide "Star" text on small screens */
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 12px 16px 16px;
      background: rgba(9, 9, 9, 0.96);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    }

    .nav-links.mobile-open {
      display: flex;
    }

    .nav-link {
      font-size: 0.9375rem;
      padding: 10px 14px;
    }
  }

  @media (max-width: 480px) {
    .cta-btn svg {
      display: none;
    }
  }
</style>
