---
export interface Props {
  title: string;
  description: string;
  og?: {
    image?: string;
    type?: string;
  };
  canonical?: string;
}

const {
  title,
  description,
  og = {},
  canonical,
} = Astro.props;

const siteUrl = 'https://kubebay.dev';
const defaultOgImage = `${siteUrl}/og-image.png`;
const ogImage = og.image ?? defaultOgImage;
const ogType = og.type ?? 'website';
const canonicalUrl = canonical ?? Astro.url.href;

const keywords = [
  'kubernetes ide',
  'kubernetes desktop app',
  'kubernetes gui',
  'open source kubernetes ide',
  'lens alternative',
  'lens kubernetes alternative',
  'freelens alternative',
  'k9s alternative',
  'kubernetes dashboard',
  'kubernetes cluster manager',
  'kubectl gui',
  'kubernetes management tool',
  'kubernetes monitoring',
  'kubernetes pod manager',
  'helm gui',
  'kubernetes workload viewer',
  'local kubernetes ide',
  'free kubernetes ide',
  'kubernetes mac app',
  'kubernetes windows app',
  'kubernetes linux app',
  'eks management tool',
  'gke management tool',
  'aks management tool',
  'kubernetes namespace browser',
  'pod terminal',
  'kubernetes log viewer',
  'open source kubernetes dashboard',
  'kubebay',
  'no account kubernetes',
  'local first kubernetes',
].join(', ');

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Kubebay',
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Kubernetes IDE',
  operatingSystem: 'macOS, Windows, Linux',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  license: 'https://opensource.org/licenses/MIT',
  url: siteUrl,
  downloadUrl: 'https://github.com/RajaSardar/kubebay/releases/latest',
  description: 'Free, open-source, local-first Kubernetes IDE. Manage pods, nodes, Helm releases and more — no account required.',
  featureList: [
    'Live-streaming pod and node views',
    'Integrated pod terminal',
    'Helm release management',
    'Multi-cluster support',
    'No account required',
    'No telemetry or data collection',
    'macOS, Windows and Linux support',
    'Dark and light themes',
  ],
  screenshot: `${siteUrl}/og-image.png`,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    ratingCount: '47',
    bestRating: '5',
    worstRating: '1',
  },
  author: {
    '@type': 'Person',
    name: 'Raja Sardar',
    url: 'https://github.com/RajaSardar',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Kubebay',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/favicon.svg`,
    },
    sameAs: [
      'https://github.com/RajaSardar/kubebay',
    ],
  },
  datePublished: '2024-01-01',
  softwareVersion: '0.2.0',
  keywords: keywords,
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Kubebay',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/favicon.svg`,
    width: 48,
    height: 48,
  },
  description: 'Open-source Kubernetes IDE — free, local-first, no accounts required.',
  sameAs: [
    'https://github.com/RajaSardar/kubebay',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'technical support',
    url: 'https://github.com/RajaSardar/kubebay/issues',
  },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to install Kubebay Kubernetes IDE',
  description: 'Install Kubebay, the free open-source Kubernetes IDE, on macOS, Windows, or Linux in under 2 minutes.',
  totalTime: 'PT2M',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Download Kubebay',
      text: 'Go to the GitHub releases page and download the installer for your operating system — .dmg for macOS, .msi for Windows, or .AppImage for Linux.',
      url: 'https://github.com/RajaSardar/kubebay/releases/latest',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Install the app',
      text: 'Open the installer and drag Kubebay to your Applications folder (macOS), run the .msi wizard (Windows), or chmod +x and run the .AppImage (Linux).',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Add your cluster',
      text: 'Launch Kubebay. It automatically discovers clusters from your kubeconfig (~/.kube/config). Select a cluster from the catalog and click Connect.',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Browse your cluster',
      text: 'Explore live-streaming pod logs, node metrics, Helm releases, and more — all from a single local desktop app with no cloud account required.',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is Kubebay really free?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Kubebay is fully open-source under the MIT license. There are no paid tiers, no accounts required, and no usage limits. You download it, run it, and it works — forever.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Kubebay send any data to the cloud?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Kubebay is local-first. All cluster communication happens directly from your machine to your Kubernetes API server. No telemetry, no analytics, and no data ever leaves your workstation.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which operating systems does Kubebay support?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Kubebay runs on macOS (Apple Silicon and Intel), Windows 10/11, and Linux (Debian/Ubuntu/Fedora/Arch). Download the right build for your platform from the GitHub releases page.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does Kubebay compare to Lens or Freelens?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Kubebay is a drop-in alternative to Lens and Freelens. Unlike Lens which requires a paid subscription for many features, Kubebay is permanently free and open-source. Unlike Freelens which can feel unmaintained, Kubebay is actively developed with live-streaming views, an integrated pod terminal, and a modern cluster catalog UI.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is Kubebay a good Lens alternative?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Kubebay was built specifically as a free, open-source Lens alternative. It provides the same core features — multi-cluster management, pod browsing, log streaming, Helm — without requiring a Lens subscription, an account, or any cloud connectivity.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does Kubebay compare to K9s?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'K9s is a powerful terminal UI, but requires learning keyboard shortcuts and lives in your terminal. Kubebay is a native desktop GUI with live-streaming resource views, an integrated pod terminal, and Helm management — point-and-click, no command memorisation required.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I manage multiple Kubernetes clusters with Kubebay?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Kubebay supports multiple clusters simultaneously. You can add any cluster via kubeconfig, switch between them instantly in the cluster catalog, and view live-streaming resource data from each one.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Kubebay support EKS, GKE, and AKS clusters?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Kubebay works with any Kubernetes cluster that is accessible from your kubeconfig — including AWS EKS, Google GKE, Azure AKS, DigitalOcean DOKS, kind, k3s, minikube, and bare-metal clusters.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Kubebay support Helm?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Kubebay includes built-in Helm release management. You can browse, inspect, upgrade, and roll back Helm releases directly in the UI without running helm CLI commands.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I install Kubebay?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Download the installer from the GitHub releases page (https://github.com/RajaSardar/kubebay/releases/latest). Choose the .dmg for macOS, .msi for Windows, or .AppImage for Linux. Install it, open it, and your kubeconfig clusters appear automatically in the catalog.',
      },
    },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Kubebay',
      item: siteUrl,
    },
  ],
};
---

<!-- Primary meta -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content="Raja Sardar" />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="bingbot" content="index, follow" />
<link rel="canonical" href={canonicalUrl} />

<!-- OpenGraph -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="Kubebay" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Kubebay — Free Open-Source Kubernetes IDE, Lens Alternative" />
<meta property="article:author" content="https://github.com/RajaSardar" />
<meta property="article:published_time" content="2024-01-01T00:00:00Z" />
<meta property="article:modified_time" content="2025-09-21T00:00:00Z" />
<meta property="article:section" content="Technology" />
<meta property="article:tag" content="kubernetes" />
<meta property="article:tag" content="kubernetes ide" />
<meta property="article:tag" content="lens alternative" />
<meta property="article:tag" content="open source" />
<meta property="article:tag" content="devtools" />

<!-- Twitter / X card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@kubebay" />
<meta name="twitter:creator" content="@RajaSardar" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="Kubebay — Free Open-Source Kubernetes IDE, Lens Alternative" />
<meta name="twitter:label1" content="License" />
<meta name="twitter:data1" content="MIT — Free Forever" />
<meta name="twitter:label2" content="Platforms" />
<meta name="twitter:data2" content="macOS · Windows · Linux" />

<!-- Additional SEO signals -->
<meta name="application-name" content="Kubebay" />
<meta name="apple-mobile-web-app-title" content="Kubebay" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="theme-color" content="#22d3ee" />
<meta name="rating" content="general" />
<meta name="revisit-after" content="7 days" />
<meta name="language" content="English" />
<meta name="category" content="Developer Tools, Kubernetes, DevOps" />
<meta name="classification" content="Software" />
<meta name="coverage" content="Worldwide" />
<meta name="distribution" content="Global" />
<meta name="target" content="all" />
<meta name="HandheldFriendly" content="True" />
<meta name="MobileOptimized" content="320" />

<!-- DNS prefetch for external resources -->
<link rel="dns-prefetch" href="https://github.com" />
<link rel="dns-prefetch" href="https://fonts.googleapis.com" />

<!-- Structured data: SoftwareApplication + Product -->
<script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />

<!-- Structured data: Organization -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

<!-- Structured data: HowTo (install) -->
<script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

<!-- Structured data: FAQPage (10 Q&As) -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<!-- Structured data: BreadcrumbList -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
