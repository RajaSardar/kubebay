---
// Community.astro — Community & Contributing section
---

<section class="community" id="community">
  <div class="community__inner">
    <header class="community__header">
      <h2 class="community__headline">Join the community. Shape what's next.</h2>
      <p class="community__subtext">
        Kubebay is MIT-licensed and community-governed. Every issue, PR, and discussion matters.
      </p>
    </header>

    <div class="community__cards">
      <a
        class="community__card"
        href="https://github.com/RajaSardar/kubebay/issues"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Open a GitHub issue"
      >
        <div class="community__card-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
        </div>
        <h3 class="community__card-title">GitHub Issues</h3>
        <p class="community__card-desc">Found a bug or have a feature request? Open an issue.</p>
        <span class="community__card-cta">
          Open an issue
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </span>
      </a>

      <a
        class="community__card community__card--accent"
        href="https://github.com/RajaSardar/kubebay/blob/main/CONTRIBUTING.md"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Read the contributing guide"
      >
        <div class="community__card-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"/>
            <polyline points="8 6 2 12 8 18"/>
          </svg>
        </div>
        <h3 class="community__card-title">Contributing</h3>
        <p class="community__card-desc">Ready to contribute? Read the guide and set up in minutes.</p>
        <span class="community__card-cta">
          Read the guide
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </span>
      </a>

      <a
        class="community__card"
        href="https://github.com/RajaSardar/kubebay/discussions"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Start a GitHub Discussion"
      >
        <div class="community__card-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <h3 class="community__card-title">Discussions</h3>
        <p class="community__card-desc">Ideas, questions, feedback? Start a discussion.</p>
        <span class="community__card-cta">
          Start a discussion
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </span>
      </a>
    </div>

    <div class="community__stats" role="list" aria-label="Project statistics">
      <div class="community__stat" role="listitem">
        <span class="community__stat-value">⭐ Stars</span>
        <span class="community__stat-label">GitHub</span>
      </div>
      <div class="community__stat-divider" aria-hidden="true"></div>
      <div class="community__stat" role="listitem">
        <span class="community__stat-value">🍴 Forks</span>
        <span class="community__stat-label">GitHub</span>
      </div>
      <div class="community__stat-divider" aria-hidden="true"></div>
      <div class="community__stat" role="listitem">
        <span class="community__stat-value">Contributors</span>
        <span class="community__stat-label">and growing</span>
      </div>
      <div class="community__stat-divider" aria-hidden="true"></div>
      <div class="community__stat" role="listitem">
        <span class="community__stat-value">MIT</span>
        <span class="community__stat-label">License</span>
      </div>
    </div>

    <div class="community__roadmap">
      <div class="community__roadmap-inner">
        <div class="community__roadmap-label">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
          Coming next
        </div>
        <p class="community__roadmap-text">
          Multi-pod log streaming, YAML edit&nbsp;+&nbsp;diff, network policy visualization
        </p>
        <a
          class="community__roadmap-link"
          href="https://github.com/RajaSardar/kubebay/blob/main/ROADMAP.md"
          target="_blank"
          rel="noopener noreferrer"
        >
          View full roadmap
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .community {
    background: #090909;
    padding: 6rem 1.5rem;
  }

  .community__inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* Header */
  .community__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }

  .community__headline {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .community__subtext {
    font-size: 1.0625rem;
    color: #9ca3af;
    line-height: 1.65;
    margin: 0;
  }

  /* Cards */
  .community__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 768px) {
    .community__cards {
      grid-template-columns: 1fr;
    }
  }

  .community__card {
    background: #111111;
    border: 1px solid #1f1f1f;
    border-radius: 12px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .community__card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 12px;
    opacity: 0;
    background: radial-gradient(circle at 50% 0%, rgba(34, 211, 238, 0.06) 0%, transparent 70%);
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .community__card:hover {
    border-color: rgba(34, 211, 238, 0.35);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(34, 211, 238, 0.08);
  }

  .community__card:hover::before {
    opacity: 1;
  }

  .community__card--accent .community__card-icon {
    color: #41c98e;
  }

  .community__card--accent:hover {
    border-color: rgba(65, 201, 142, 0.35);
    box-shadow: 0 8px 32px rgba(65, 201, 142, 0.08);
  }

  .community__card--accent::before {
    background: radial-gradient(circle at 50% 0%, rgba(65, 201, 142, 0.06) 0%, transparent 70%);
  }

  .community__card-icon {
    color: #22d3ee;
    flex-shrink: 0;
  }

  .community__card-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: #f3f4f6;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .community__card-desc {
    font-size: 0.9375rem;
    color: #6b7280;
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .community__card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #22d3ee;
    margin-top: 0.5rem;
    transition: gap 0.2s ease;
  }

  .community__card--accent .community__card-cta {
    color: #41c98e;
  }

  .community__card:hover .community__card-cta {
    gap: 0.625rem;
  }

  /* Stats strip */
  .community__stats {
    background: #111111;
    border: 1px solid #1f1f1f;
    border-radius: 12px;
    padding: 1.5rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
    row-gap: 1.25rem;
  }

  .community__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0 2rem;
    flex: 1;
    min-width: 120px;
  }

  .community__stat-value {
    font-size: 1.125rem;
    font-weight: 600;
    color: #f3f4f6;
    letter-spacing: -0.01em;
  }

  .community__stat-label {
    font-size: 0.8125rem;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .community__stat-divider {
    width: 1px;
    height: 2.5rem;
    background: #1f1f1f;
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .community__stats {
      flex-direction: column;
      gap: 1rem;
    }

    .community__stat-divider {
      display: none;
    }
  }

  /* Roadmap teaser */
  .community__roadmap {
    border: 1px dashed rgba(34, 211, 238, 0.25);
    border-radius: 12px;
    background: rgba(34, 211, 238, 0.03);
  }

  .community__roadmap-inner {
    padding: 1.5rem 2rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    row-gap: 0.75rem;
  }

  .community__roadmap-label {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #22d3ee;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.2);
    border-radius: 9999px;
    padding: 0.3rem 0.8rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .community__roadmap-text {
    font-size: 0.9375rem;
    color: #9ca3af;
    margin: 0;
    flex: 1;
    line-height: 1.5;
  }

  .community__roadmap-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #22d3ee;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: gap 0.2s ease;
  }

  .community__roadmap-link:hover {
    gap: 0.625rem;
  }
</style>
