---
const version = "v0.2.0";
const releasesUrl = "https://github.com/RajaSardar/kubebay/releases/latest";
---

<section class="download" id="download">
  <div class="download__inner">
    <div class="download__header">
      <h2 class="download__title">Get Kubebay in 30 seconds</h2>
      <p class="download__sub">Native desktop app · Web engine · In-cluster Helm chart</p>
      <a class="download__version-badge" href={releasesUrl} target="_blank" rel="noopener noreferrer">
        Latest: {version}
      </a>
    </div>

    <div class="tabs" role="tablist" aria-label="Installation options">
      <button class="tabs__tab tabs__tab--active" role="tab" aria-selected="true" aria-controls="tab-macos" data-tab="macos">
        <span class="tabs__icon" aria-hidden="true">
          <!-- Apple logo -->
          <svg width="16" height="16" viewBox="0 0 814 1000" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76 0-103.7 40.8-165.9 40.8s-105-57.8-155.5-127.4C46 790.7 0 663 0 541.8c0-207.5 135.4-317.3 269-317.3 70.1 0 128.4 46.4 172.5 46.4 42.8 0 109.5-49 192.7-49 31.1 0 108.2 2.6 168.6 71.2zm-174.6-123.5c-31.8-37.9-79.5-65.5-129.4-65.5-7.4 0-14.8.6-21.5 1.9 1.3-7.4 1.9-14.8 1.9-23.5 0-68.7-47.7-141.2-127.4-141.2-90.8 0-142.5 75.8-142.5 140.6 0 19.2 3.2 38.5 9.6 55.5 4.5-1.3 9-1.9 13.5-1.9 51.2 0 100.9-39.5 100.9-39.5s-3.2 50.3-50.3 91.7c-6.4 5.8-13.5 10.9-21.5 14.8 64.1-3.2 147.3-51.2 147.3-51.2s-12.8 66.1-90.8 117.9c27.6 3.8 56.5.6 84.1-9.6 30.5-11.5 57.8-30.5 79.5-55.5 30.5 2.6 60.9 12.8 87.5 28.8 26.6 16 48.3 38.5 63.1 64.8.6-1.9.6-3.8.6-5.8 0-50.8-23.5-99.9-54.6-134.2z"/>
          </svg>
        </span>
        macOS
      </button>
      <button class="tabs__tab" role="tab" aria-selected="false" aria-controls="tab-windows" data-tab="windows">
        <span class="tabs__icon" aria-hidden="true">
          <!-- Windows logo -->
          <svg width="16" height="16" viewBox="0 0 88 88" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 12.402l35.687-4.86.016 34.318-35.67.203zm35.67 33.529l.028 34.344L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349l-.011 41.34-47.318-6.678-.066-34.739z"/>
          </svg>
        </span>
        Windows
      </button>
      <button class="tabs__tab" role="tab" aria-selected="false" aria-controls="tab-linux" data-tab="linux">
        <span class="tabs__icon" aria-hidden="true">
          <!-- Linux Tux penguin -->
          <svg width="16" height="16" viewBox="0 0 48 48" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M24 3c-3.4 0-6 2.5-6.3 5.7-.2 2 .5 3.9 1.8 5.3-2 1.6-3.5 4-3.5 6.7 0 1.2.4 2.5.9 3.6-1.1.7-2.2 1.7-3 2.9-1.4 2.1-1.9 4.7-1.3 7.1.5 2 1.8 3.8 3.6 5C14.7 40.4 13 42 13 44h22c0-2-1.7-3.6-3.2-4.7 1.8-1.2 3.1-3 3.6-5 .6-2.4.1-5-1.3-7.1-.8-1.2-1.9-2.2-3-2.9.5-1.1.9-2.4.9-3.6 0-2.7-1.5-5.1-3.5-6.7 1.3-1.4 2-3.3 1.8-5.3C30 5.5 27.4 3 24 3zm0 2c2.5 0 4.3 1.8 4.3 4 0 1.5-.7 2.9-1.8 3.8-.5.4-1.1.7-1.8.9-1.5.4-2.1.4-3.6.4-.9 0-1.6-.1-2.3-.4-.6-.2-1.2-.5-1.7-.9C16.1 11.9 15.5 10.5 15.5 9c0-2.2 1.8-4 4-4h4.5zm-1.5 4.5c-.5 0-.9.2-1.2.5-.3.3-.5.7-.5 1.1 0 .4.2.8.5 1.1.3.3.7.5 1.2.5.4 0 .8-.2 1.1-.5.3-.3.5-.7.5-1.1 0-.4-.2-.8-.5-1.1-.3-.3-.7-.5-1.1-.5zm3.2 0c-.4 0-.8.2-1.1.5-.3.3-.5.7-.5 1.1 0 .4.2.8.5 1.1.3.3.7.5 1.1.5.5 0 .9-.2 1.2-.5.3-.3.5-.7.5-1.1 0-.4-.2-.8-.5-1.1-.3-.3-.7-.5-1.2-.5z"/>
          </svg>
        </span>
        Linux
      </button>
      <button class="tabs__tab" role="tab" aria-selected="false" aria-controls="tab-helm" data-tab="helm">
        <span class="tabs__icon" aria-hidden="true">
          <!-- Helm logo (simplified) -->
          <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M128 0C57.3 0 0 57.3 0 128s57.3 128 128 128 128-57.3 128-128S198.7 0 128 0zm0 24c57.4 0 104 46.6 104 104S185.4 232 128 232 24 185.4 24 128 70.6 24 128 24zm-40 56v16h80V80h-80zm0 32v16h80v-16h-80zm0 32v32h16v-16h48v16h16v-32H88z"/>
          </svg>
        </span>
        Helm
      </button>
      <div class="tabs__indicator" aria-hidden="true"></div>
    </div>

    <div class="tab-panels">

      <!-- macOS -->
      <div class="tab-panel tab-panel--active" id="tab-macos" role="tabpanel">
        <div class="install-method install-method--primary">
          <div class="install-method__label">One-liner install</div>
          <div class="code-block">
            <pre><code><span class="code-cmd">curl</span> <span class="code-flag">-fsSL</span> https://github.com/RajaSardar/kubebay/releases/latest/download/install-mac.sh <span class="code-pipe">|</span> <span class="code-cmd">bash</span></code></pre>
            <button class="code-block__copy" aria-label="Copy command" data-copy="curl -fsSL https://github.com/RajaSardar/kubebay/releases/latest/download/install-mac.sh | bash">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span>Copy</span>
            </button>
          </div>
        </div>

        <div class="install-divider"><span>or</span></div>

        <div class="install-alts">
          <a class="install-btn" href={releasesUrl} target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download .dmg
          </a>

          <div class="install-method install-method--secondary">
            <div class="install-method__label">Homebrew</div>
            <div class="code-block">
              <pre><code><span class="code-cmd">brew</span> install rajasardar/tap/kubebay</code></pre>
              <button class="code-block__copy" aria-label="Copy command" data-copy="brew install rajasardar/tap/kubebay">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Copy</span>
              </button>
            </div>
          </div>
        </div>

        <p class="install-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Universal binary — Apple Silicon and Intel
        </p>
      </div>

      <!-- Windows -->
      <div class="tab-panel" id="tab-windows" role="tabpanel" hidden>
        <div class="install-alts">
          <a class="install-btn" href="https://github.com/RajaSardar/kubebay/releases/latest/download/Kubebay_x64_en-US.msi" target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download .exe Installer
          </a>
        </div>

        <div class="install-divider"><span>or via winget</span></div>

        <div class="install-method install-method--secondary">
          <div class="install-method__label">Windows Package Manager</div>
          <div class="code-block">
            <pre><code><span class="code-cmd">winget</span> install Kubebay.Kubebay</code></pre>
            <button class="code-block__copy" aria-label="Copy command" data-copy="winget install Kubebay.Kubebay">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span>Copy</span>
            </button>
          </div>
        </div>

        <p class="install-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Architecture: x86_64
        </p>
      </div>

      <!-- Linux -->
      <div class="tab-panel" id="tab-linux" role="tabpanel" hidden>
        <div class="install-alts">
          <a class="install-btn" href="https://github.com/RajaSardar/kubebay/releases/latest/download/kubebay_amd64.AppImage" target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download .AppImage
          </a>
          <a class="install-btn install-btn--ghost" href="https://github.com/RajaSardar/kubebay/releases/latest/download/kubebay_amd64.deb" target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download .deb
          </a>
        </div>

        <div class="install-divider"><span>or</span></div>

        <div class="install-method install-method--secondary">
          <div class="install-method__label">One-liner install</div>
          <div class="code-block">
            <pre><code><span class="code-cmd">curl</span> <span class="code-flag">-fsSL</span> https://github.com/RajaSardar/kubebay/releases/latest/download/install-linux.sh <span class="code-pipe">|</span> <span class="code-cmd">bash</span></code></pre>
            <button class="code-block__copy" aria-label="Copy command" data-copy="curl -fsSL https://github.com/RajaSardar/kubebay/releases/latest/download/install-linux.sh | bash">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span>Copy</span>
            </button>
          </div>
        </div>

        <p class="install-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Architectures: x86_64, ARM64
        </p>
      </div>

      <!-- Helm -->
      <div class="tab-panel" id="tab-helm" role="tabpanel" hidden>
        <div class="install-method install-method--primary">
          <div class="install-method__label">Add the Helm repo and install</div>
          <div class="code-block code-block--multi">
            <pre><code><span class="code-cmd">helm</span> repo add kubebay https://rajasardar.github.io/kubebay
<span class="code-cmd">helm</span> install kubebay kubebay/kubebay</code></pre>
            <button class="code-block__copy" aria-label="Copy commands" data-copy="helm repo add kubebay https://rajasardar.github.io/kubebay
helm install kubebay kubebay/kubebay">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span>Copy</span>
            </button>
          </div>
        </div>

        <p class="install-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Deploys the web engine into your cluster — access Kubebay from any browser without installing a desktop app.
        </p>
      </div>

    </div>
  </div>
</section>

<script>
  function initDownloadTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.tabs__tab');
    const panels = document.querySelectorAll<HTMLElement>('.tab-panel');
    const indicator = document.querySelector<HTMLElement>('.tabs__indicator');

    function moveIndicator(tab: HTMLButtonElement) {
      if (!indicator) return;
      const tabRect = tab.getBoundingClientRect();
      const barRect = tab.closest('.tabs')!.getBoundingClientRect();
      indicator.style.width = `${tabRect.width}px`;
      indicator.style.left = `${tabRect.left - barRect.left}px`;
    }

    function activateTab(tab: HTMLButtonElement) {
      const target = tab.dataset.tab;
      tabs.forEach(t => {
        t.classList.remove('tabs__tab--active');
        t.setAttribute('aria-selected', 'false');
      });
      panels.forEach(p => {
        p.classList.remove('tab-panel--active');
        p.hidden = true;
      });
      tab.classList.add('tabs__tab--active');
      tab.setAttribute('aria-selected', 'true');
      const panel = document.getElementById(`tab-${target}`);
      if (panel) {
        panel.classList.add('tab-panel--active');
        panel.hidden = false;
      }
      moveIndicator(tab);
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => activateTab(tab));
    });

    // Initialise indicator on first active tab
    const firstActive = document.querySelector<HTMLButtonElement>('.tabs__tab--active');
    if (firstActive) {
      requestAnimationFrame(() => moveIndicator(firstActive));
    }

    // Copy buttons
    document.querySelectorAll<HTMLButtonElement>('.code-block__copy').forEach(btn => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy ?? '';
        await navigator.clipboard.writeText(text);
        const span = btn.querySelector('span');
        if (span) {
          span.textContent = 'Copied!';
          setTimeout(() => { span.textContent = 'Copy'; }, 2000);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initDownloadTabs);
</script>

<style>
  .download {
    background: #090909;
    padding: 96px 24px;
  }

  .download__inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .download__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .download__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: #fff;
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }

  .download__sub {
    font-size: 1rem;
    color: #8a8a8a;
    margin: 0 0 20px;
  }

  .download__version-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 20px;
    border: 1px solid rgba(34, 211, 238, 0.3);
    background: rgba(34, 211, 238, 0.06);
    color: #22d3ee;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }

  .download__version-badge:hover {
    background: rgba(34, 211, 238, 0.12);
    border-color: rgba(34, 211, 238, 0.5);
  }

  /* ── Tabs ── */
  .tabs {
    display: flex;
    align-items: center;
    gap: 4px;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 32px;
    padding-bottom: 0;
  }

  .tabs__tab {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 18px 12px;
    background: none;
    border: none;
    color: #8a8a8a;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.2s;
    position: relative;
    white-space: nowrap;
  }

  .tabs__tab:hover {
    color: #e5e5e5;
  }

  .tabs__tab--active {
    color: #fff;
  }

  .tabs__icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .tabs__indicator {
    position: absolute;
    bottom: -1px;
    height: 2px;
    background: #22d3ee;
    border-radius: 2px 2px 0 0;
    transition: left 0.25s cubic-bezier(0.4, 0, 0.2, 1), width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  /* ── Tab panels ── */
  .tab-panel {
    animation: fadeIn 0.2s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Install methods ── */
  .install-method {
    margin-bottom: 20px;
  }

  .install-method__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8a8a8a;
    margin-bottom: 8px;
  }

  .install-method--primary .code-block {
    border-color: rgba(34, 211, 238, 0.2);
  }

  /* ── Code block ── */
  .code-block {
    position: relative;
    background: #0d0d0d;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    overflow: hidden;
  }

  .code-block pre {
    margin: 0;
    padding: 16px 52px 16px 18px;
    overflow-x: auto;
  }

  .code-block code {
    font-family: "Fira Code", "Cascadia Code", ui-monospace, "SF Mono", monospace;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #e5e5e5;
  }

  .code-block--multi pre {
    padding-right: 56px;
  }

  .code-cmd  { color: #22d3ee; }
  .code-flag { color: #a78bfa; }
  .code-pipe { color: #f9a8d4; }

  .code-block__copy {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 5px;
    color: #8a8a8a;
    font-size: 0.75rem;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s, color 0.2s, background 0.2s;
  }

  .code-block:hover .code-block__copy {
    opacity: 1;
  }

  .code-block__copy:hover {
    color: #e5e5e5;
    background: rgba(255, 255, 255, 0.1);
  }

  /* ── Divider ── */
  .install-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0;
    color: #8a8a8a;
    font-size: 0.8rem;
  }

  .install-divider::before,
  .install-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  /* ── Alt buttons ── */
  .install-alts {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .install-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: #22d3ee;
    color: #090909;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 7px;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }

  .install-btn:hover {
    background: #38bdf8;
    transform: translateY(-1px);
  }

  .install-btn--ghost {
    background: transparent;
    color: #e5e5e5;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .install-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-1px);
  }

  /* ── Note ── */
  .install-note {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 20px 0 0;
    font-size: 0.8rem;
    color: #8a8a8a;
  }

  .install-note svg {
    flex-shrink: 0;
    opacity: 0.6;
  }
</style>
