---
const principles = [
  {
    badge: "01",
    title: "Truly Local-First",
    description:
      "No accounts, no cloud control plane, no mandatory telemetry. Your kubeconfig stays on your machine. Your clusters stay yours — always.",
    icon: `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="8" y="16" width="24" height="18" rx="3" stroke="currentColor" stroke-width="1.5"/>
      <path d="M14 16V12C14 8.68629 16.6863 6 20 6C23.3137 6 26 8.68629 26 12V16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="20" cy="25" r="3" fill="currentColor"/>
      <line x1="20" y1="28" x2="20" y2="31" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>`,
    color: "#22d3ee",
    highlights: ["Zero account required", "No telemetry by default", "Offline-capable"],
  },
  {
    badge: "02",
    title: "Built to Perform",
    description:
      "Go engine. Not Electron. ≤150 MB idle RAM, ≤1.5s cold start, 40 MB installer. Fast enough to keep up with your cluster, lean enough to leave in the background.",
    icon: `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M8 30L16 18L22 24L28 12L34 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="8" cy="30" r="2" fill="currentColor"/>
      <circle cx="34" cy="20" r="2" fill="currentColor"/>
      <path d="M30 10L34 10L34 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`,
    color: "#41c98e",
    highlights: ["≤150 MB idle RAM", "≤1.5s cold start", "40 MB installer"],
  },
  {
    badge: "03",
    title: "Permanently Free",
    description:
      "MIT licensed. No freemium tier. No bait-and-switch subscription. Public roadmap, community-governed. Free today, free in five years — that's a promise in the license.",
    icon: `<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M20 6L24.5 15.5L35 17L27.5 24.5L29.5 35L20 30L10.5 35L12.5 24.5L5 17L15.5 15.5L20 6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M15 20L18.5 23.5L26 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`,
    color: "#a78bfa",
    highlights: ["MIT license", "No freemium traps", "Community-governed"],
  },
];

const timeline = [
  { year: "2016", label: "Kubernetes Dashboard", status: "archived", note: "Official dashboard — archived Jan 2026" },
  { year: "2019", label: "Lens IDE", status: "closed", note: "Open-source launch — went closed-source + subscription in 2023" },
  { year: "2023", label: "OpenLens / Freelens", status: "heavy", note: "Community fork — Electron-heavy, maintenance burden" },
  { year: "2025", label: "Kubebay", status: "current", note: "Native Go engine. Local-first. MIT. Free forever." },
];
---

<section class="why-kubebay" id="why">
  <div class="container">
    <header class="section-header">
      <div class="eyebrow">Why switch?</div>
      <h2>The Kubernetes UI you've been waiting for</h2>
      <p class="subtext">
        Lens went closed-source. Freelens is Electron-heavy. The official Dashboard was archived in January 2026.
        It's time for something better.
      </p>
    </header>

    <div class="principles-grid">
      {principles.map((p) => (
        <article class="principle-card" style={`--accent: ${p.color};`}>
          <div class="card-top">
            <div class="badge">{p.badge}</div>
            <div class="icon" set:html={p.icon} />
          </div>
          <h3>{p.title}</h3>
          <p>{p.description}</p>
          <ul class="highlights">
            {p.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="timeline-section">
      <h4 class="timeline-heading">The Kubernetes UI landscape</h4>
      <div class="timeline">
        {timeline.map((item, i) => (
          <div class={`timeline-item ${item.status}`} data-i={i}>
            <div class="timeline-dot">
              <div class="dot-inner" />
            </div>
            <div class="timeline-content">
              <div class="timeline-year">{item.year}</div>
              <div class="timeline-label">{item.label}</div>
              <div class="timeline-note">{item.note}</div>
            </div>
          </div>
        ))}
        <div class="timeline-line" />
      </div>
    </div>
  </div>
</section>

<script>
  const cards = document.querySelectorAll('.principle-card');
  const timelineItems = document.querySelectorAll('.timeline-item');
  const timelineLine = document.querySelector('.timeline-line') as HTMLElement;

  const cardObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add('visible');
          cardObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  cards.forEach((c, i) => {
    (c as HTMLElement).style.transitionDelay = `${i * 80}ms`;
    cardObserver.observe(c);
  });

  const timelineObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const items = document.querySelectorAll('.timeline-item');
          items.forEach((item, i) => {
            setTimeout(() => {
              (item as HTMLElement).classList.add('visible');
            }, i * 120);
          });
          if (timelineLine) {
            setTimeout(() => timelineLine.classList.add('drawn'), 100);
          }
          timelineObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.2 }
  );

  const timelineSection = document.querySelector('.timeline-section');
  if (timelineSection) timelineObserver.observe(timelineSection);
</script>

<style>
  .why-kubebay {
    background: linear-gradient(180deg, #111111 0%, #0e0e0e 100%);
    padding: 100px 24px;
    position: relative;
    overflow: hidden;
  }

  .why-kubebay::before {
    content: '';
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 400px;
    background: radial-gradient(ellipse at center, rgba(34, 211, 238, 0.04) 0%, transparent 70%);
    pointer-events: none;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }

  .section-header {
    text-align: center;
    margin-bottom: 72px;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #22d3ee;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.18);
    padding: 4px 14px;
    border-radius: 100px;
    margin-bottom: 20px;
  }

  .section-header h2 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    color: #f0f0f0;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 0 0 16px;
  }

  .subtext {
    max-width: 560px;
    margin: 0 auto;
    font-size: 1rem;
    color: #8a8a8a;
    line-height: 1.7;
  }

  /* Principles grid */
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 80px;
  }

  @media (max-width: 900px) {
    .principles-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  .principle-card {
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 36px 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 0;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s ease,
      opacity 0.5s ease,
      translate 0.5s ease;
    opacity: 0;
    translate: 0 24px;
    position: relative;
    overflow: hidden;
  }

  .principle-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .principle-card.visible {
    opacity: 1;
    translate: 0 0;
  }

  .principle-card:hover {
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 12%, transparent),
      0 16px 40px rgba(0, 0, 0, 0.4),
      0 4px 12px color-mix(in srgb, var(--accent) 8%, transparent);
    transform: translateY(-3px);
  }

  .principle-card:hover::before {
    opacity: 1;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
  }

  .badge {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    padding: 3px 10px;
    border-radius: 100px;
    font-variant-numeric: tabular-nums;
  }

  .icon {
    color: var(--accent);
    opacity: 0.85;
  }

  .icon :global(svg) {
    width: 40px;
    height: 40px;
  }

  .principle-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: #f0f0f0;
    margin: 0 0 14px;
    letter-spacing: -0.02em;
  }

  .principle-card > p {
    font-size: 0.9rem;
    color: #8a8a8a;
    line-height: 1.7;
    margin: 0 0 24px;
    flex: 1;
  }

  .highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 20px;
  }

  .highlights li {
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--accent) 80%, #f0f0f0);
    padding-left: 18px;
    position: relative;
  }

  .highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.7;
  }

  /* Timeline */
  .timeline-section {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 64px;
  }

  .timeline-heading {
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8a8a8a;
    margin: 0 0 48px;
  }

  .timeline {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
    position: relative;
    padding: 0 24px;
  }

  .timeline-line {
    position: absolute;
    top: 10px;
    left: calc(12.5% + 12px);
    right: calc(12.5% + 12px);
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .timeline-line::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #22d3ee, #41c98e, #a78bfa);
    transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .timeline-line.drawn::after {
    width: 100%;
  }

  .timeline-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    opacity: 0;
    translate: 0 12px;
    transition: opacity 0.4s ease, translate 0.4s ease;
    padding: 0 8px;
  }

  .timeline-item.visible {
    opacity: 1;
    translate: 0 0;
  }

  .timeline-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .archived .timeline-dot {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .closed .timeline-dot {
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.25);
  }

  .heavy .timeline-dot {
    background: rgba(251, 191, 36, 0.08);
    border: 1px solid rgba(251, 191, 36, 0.25);
  }

  .current .timeline-dot {
    background: rgba(34, 211, 238, 0.12);
    border: 1px solid rgba(34, 211, 238, 0.4);
    box-shadow: 0 0 12px rgba(34, 211, 238, 0.2);
  }

  .dot-inner {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .archived .dot-inner { background: rgba(255, 255, 255, 0.25); }
  .closed .dot-inner { background: #ef4444; opacity: 0.7; }
  .heavy .dot-inner { background: #fbbf24; opacity: 0.8; }
  .current .dot-inner { background: #22d3ee; }

  .timeline-content {
    text-align: center;
  }

  .timeline-year {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #8a8a8a;
    margin-bottom: 4px;
    font-variant-numeric: tabular-nums;
  }

  .current .timeline-year {
    color: #22d3ee;
  }

  .timeline-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #f0f0f0;
    margin-bottom: 6px;
    line-height: 1.3;
  }

  .archived .timeline-label { color: #8a8a8a; }
  .closed .timeline-label { color: #f0f0f0; }

  .timeline-note {
    font-size: 0.75rem;
    color: #8a8a8a;
    line-height: 1.5;
  }

  .archived .timeline-note { color: rgba(138, 138, 138, 0.6); }
  .closed .timeline-note { color: rgba(239, 68, 68, 0.7); }
  .heavy .timeline-note { color: rgba(251, 191, 36, 0.7); }
  .current .timeline-note { color: rgba(34, 211, 238, 0.8); font-weight: 500; }

  @media (max-width: 640px) {
    .timeline {
      flex-direction: column;
      align-items: flex-start;
      padding-left: 20px;
    }

    .timeline-line {
      top: calc(12.5% + 12px);
      bottom: calc(12.5% + 12px);
      left: 28px;
      right: auto;
      width: 1px;
      height: auto;
    }

    .timeline-line::after {
      top: 0;
      left: 0;
      width: 100%;
      height: 0%;
      transition: height 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .timeline-line.drawn::after {
      width: 100%;
      height: 100%;
    }

    .timeline-item {
      flex-direction: row;
      align-items: flex-start;
      gap: 16px;
    }

    .timeline-content {
      text-align: left;
    }
  }
</style>
